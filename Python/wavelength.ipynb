   "source": [
    "c = 299_792_458       # speed of light in m/s\n",
    "f = 145.8e6           # frequency in Hz\n",
    "\n",
    "wavelength = c / f\n",
    "dipole_length = wavelength / 2\n",
    "\n",
    "print(f\"Frequency: {f/1e6:.1f} MHz\")\n",
    "print(f\"Wavelength: {wavelength:.4f} m\")\n",
    "print(f\"Half-wave dipole length: {dipole_length:.4f} m\")"
   ]
  }
